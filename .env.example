# Synora environment variables (copy to .env and adjust)
# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/synora
DATABASE_USERNAME=synora
DATABASE_PASSWORD=synora

# Security
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# AI engine (Ollama optional — falls back to deterministic demo provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_PROVIDER=auto

# Frontend
API_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Sample accounts and cases are disabled by default.
SYNORA_SEED_ENABLED=false

# Export these in the Java backend's environment to enable Google + phone auth.
# Use the SAME Firebase project as frontend/.env.local.
FIREBASE_PROJECT_ID=
# Absolute path to a Firebase Admin service-account JSON, kept outside the project.
GOOGLE_APPLICATION_CREDENTIALS=
