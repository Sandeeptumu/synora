FIREBASE_PROJECT_ID=synora-b6774
# Local only: absolute path to the downloaded Firebase Admin service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json

# Render only: set this in Render's Environment page, not in this file or Git.
# Generate it locally with: base64 < firebase-adminsdk.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
