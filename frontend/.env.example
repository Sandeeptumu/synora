# Public Firebase web-app settings from Firebase Console > Project settings.
# Copy this file to .env.local, fill the values, then restart Vite.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Leave empty for the local Vite /api proxy to localhost:8080.
# For Vercel, set this in Project Settings > Environment Variables to your
# Render HTTPS origin (without /api), for example https://your-api.onrender.com.
VITE_API_BASE_URL=
